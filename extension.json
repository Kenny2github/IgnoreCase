{
	"name": "IgnoreCase",
	"namemsg": "ignorecase-extensionname",
	"author": [
		"AbyxDev"
	],
	"descriptionmsg": "ignorecase-desc",
	"url": "https://www.mediawiki.org/wiki/Extension:IgnoreCase",
	"license-name": "MIT",
	"type": "other",
	"MessagesDirs": {
		"IgnoreCase": ["i18n"]
	},
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"AutoloadClasses": {
		"IgnoreCase": "IgnoreCase.php"
	},
	"HookHandlers": {
		"IgnoreCaseHooks": {
			"class": "IgnoreCase",
			"services": [
				"DBLoadBalancer",
				"ConfigFactory",
				"RedirectStore"
			]
		}
	},
	"Hooks": {
		"BeforeDisplayNoArticleText": "IgnoreCaseHooks",
		"InitializeArticleMaybeRedirect": "IgnoreCaseHooks",
		"PageSaveComplete": "IgnoreCaseHooks",
		"PageUndeleteComplete": "IgnoreCaseHooks",
		"ArticlePurge": "IgnoreCaseHooks",
		"AfterImportPage": "IgnoreCaseHooks",
		"ApiOpenSearchSuggest": "IgnoreCaseHooks",
		"HtmlPageLinkRendererBegin": "IgnoreCaseHooks",
		"HtmlPageLinkRendererEnd": "IgnoreCaseHooks"
	},
	"config": {
		"IgnoreCaseInLinks": {
			"value": true
		},
		"IgnoreCaseInSearchSuggestions": {
			"value": true
		}
	},
	"manifest_version": 2
}
